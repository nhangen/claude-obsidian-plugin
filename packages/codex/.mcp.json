{
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "python3",
      "args": ["-I", "-B", "scripts/connection.py", "read"],
      "cwd": ".",
      "env_vars": ["CODEX_HOME"]
    },
    "obsidian-write": {
      "type": "stdio",
      "command": "python3",
      "args": ["-I", "-B", "scripts/connection.py", "write"],
      "cwd": ".",
      "env_vars": ["CODEX_HOME"]
    }
  }
}
