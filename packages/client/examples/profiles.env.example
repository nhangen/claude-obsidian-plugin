# Choose independently scoped endpoints and credential sources per profile.
OBSIDIAN_MCP_READ_ENDPOINT=https://mcp.example.invalid/mcp
OBSIDIAN_MCP_READ_CREDENTIAL_PROVIDER=env
OBSIDIAN_MCP_READ_TOKEN_ENV=MY_OBSIDIAN_READ_TOKEN

OBSIDIAN_MCP_WRITE_ENDPOINT=https://mcp.example.invalid/mcp
OBSIDIAN_MCP_WRITE_CREDENTIAL_PROVIDER=keychain
OBSIDIAN_MCP_WRITE_KEYCHAIN_SERVICE=example-obsidian-write
OBSIDIAN_MCP_WRITE_KEYCHAIN_ACCOUNT=example-user
