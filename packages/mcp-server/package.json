{
  "name": "@claude-obsidian/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server over stdio and authenticated Streamable HTTP.",
  "type": "module",
  "main": "src/stdio.mjs",
  "scripts": {
    "build": "node --check src/stdio.mjs && node --check src/http.mjs",
    "start": "node src/stdio.mjs",
    "start:http": "node src/http.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  }
}
