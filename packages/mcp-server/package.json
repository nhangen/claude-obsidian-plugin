{
  "name": "@claude-obsidian/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian MCP server over stdio and authenticated Streamable HTTP.",
  "type": "module",
  "main": "dist/stdio.mjs",
  "files": [
    "dist/",
    "contract.json",
    "README.md"
  ],
  "bin": {
    "claude-obsidian-mcp": "dist/stdio.mjs",
    "claude-obsidian-mcp-http": "dist/http.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "start": "node dist/stdio.mjs",
    "start:http": "node dist/http.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "typescript": "5.9.2"
  }
}
