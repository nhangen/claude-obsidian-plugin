{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__obsidian-write__obsidian_keeper_save|mcp__obsidian-write__obsidian_daily_append)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|mcp__obsidian-write__obsidian_keeper_save|mcp__obsidian-write__obsidian_daily_append)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" UserPromptSubmit", "timeout": 10}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "^(Bash|mcp__obsidian-write__obsidian_keeper_save|mcp__obsidian-write__obsidian_daily_append)$", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" PostToolUseFailure", "timeout": 10}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" StopFailure", "timeout": 10}]}
    ]
  }
}
